{
  "name": "kabelsalat",
  "version": "0.5.0",
  "description": "Kabelsalat: Offline-2D/3D-Schachteditor mit Einhausungsplatten, Konsolen und Varianten",
  "main": "main.js",
  "author": "Eugi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --check main.js && node --check editor2d.js && node --check components.js && node --check app.js && node tests/smoke.test.js && node tests/editor2d.test.js && node tests/components.test.js",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.eugi.kabelsalat",
    "productName": "Kabelsalat",
    "asar": true,
    "files": [
      "index.html",
      "app.js",
      "editor2d.js",
      "components.js",
      "main.js",
      "vendor/three.min.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kabelsalat-${version}-Windows.exe"
    }
  }
}
